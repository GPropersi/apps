# Host-side Cloudflare Access settings, read by `platform deploy` from /etc/platform/access.env and passed to every app as
# ACCESS_TEAM_DOMAIN / ACCESS_AUD. This copy holds placeholders only: the real values are account-specific, so the real
# file lives only on the host (root-owned, mode 0644, never group or world writable) and is never committed.
#
# ACCESS_TEAM_DOMAIN: the team domain of your Zero Trust organisation (Zero Trust, Settings, Custom Pages shows it).
# ACCESS_AUD: the Application Audience (AUD) tag of the wildcard Access application (64 lowercase hex characters).
ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
ACCESS_AUD=<64 lowercase hex characters>
