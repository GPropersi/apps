# Host-side settings for the ingress stack. The installer reads the real file at /etc/platform/ingress.env;
# this copy holds placeholders only. DOCKER_GID is not set here: the installer derives it from the Docker socket.
#
# The tunnel token is NOT a setting here. It lives in /etc/platform/cloudflared.token, owner root, group = the
# dedicated token group (fixed gid in compose.yaml, no members), mode 0640.
PLATFORM_DOMAIN=example.test
